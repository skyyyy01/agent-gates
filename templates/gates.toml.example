# gates.toml —— 常驻文件的读取预算
#
# 复制到仓库根、改名 gates.toml，按你自己的项目改写。
# 没有这个文件时 checker 会明说「本次什么都没检查」并退出 0 —— 它**不会**静默通过，
# 因为「忘了配置」和「配置说这些就够了」必须长得不一样。
#
# ── 为什么按体积而不是按条数 ──────────────────────────────
# 真实教训：某个文件的规则原本写的是「≤15 条」，实测 `grep -c '^## '` 恰好 15 条、
# 完全合规，而文件已经 119 KB。条数是可绕过的代理指标，膨胀从两条缝里溢出来：
#   ① 归档做了一半：旧条目压成单行留在原地，压平行不以 `## ` 开头 ⇒ 计数数不到
#   ② 格式混用：旧式分节标题不匹配 ⇒ 正文被算进上一条，单条虚高
# 体积没有这些缝。
#
# 所有上限一律写 KB（人读的单位），内部换算成字节比较。


# ── 单文件预算（三个维度）────────────────────────────────
# max_file_kb  整份文件 —— 这是「每次会话都要读它」的总代价
# max_entry_kb 单个条目（以 `## ` 分节）—— 防止一条吃掉整个预算
# max_line_kb  单行 —— 长行通常意味着「压平了但没搬走」，是归档做一半的指纹
#
# 三个 hint 是这个工具好用的原因：报错时直接告诉人该怎么拆，而不是只说「超了」。
# 它们的语义随文件结构而变，所以各写各的，别共用一套文案。

[[budget]]
path = "CLAUDE.md"
max_file_kb = 40
max_entry_kb = 15
max_line_kb = 2
file_hint = "先把不够格的条目下沉到按需读的文件，再合并同族条目，最后才考虑提高上限"
entry_hint = "只留结论 + 指向详细文档的链接，别把分析全文塞进来"
line_hint = "疑似压平行 —— 压平格式只属于归档文件"

[[budget]]
path = "docs/state/current.md"
max_file_kb = 50
max_entry_kb = 9
max_line_kb = 2
file_hint = "读取预算是固定的，先出后进：把最老的条目移进 archive/ 并留一行摘要 + 指针"
entry_hint = "只留结论 + 链接"
line_hint = "疑似压平行"
# max_lines = 500   # 可选第四维：当某份文档的预算本来就是用行数写的（如「≤500 行」），
                    # 让机制去匹配已有的字，而不是改文字去迁就脚本


# ── 面级预算（glob）──────────────────────────────────────
# 逐个点名是**载体层**写法：下次新增一个文件又漏。
# 真实教训：上午刚给三个文件装了闸门，当天下午往同目录搬内容时才发现另外 5 个文件
# 一个都没设防 —— 膨胀立刻找到了没设防的出口。按目录 glob 才是抽象层。
#
# ⚠️ 已有专属 [[budget]] 的文件会被自动排除：两套规则管同一个文件、上限还不同，
#    必然有一个在说谎。面级只兜底「没人管」的那些。
# ⚠️ glob 零命中会**报错**而不是静默放过 —— 零命中等于这道闸门不存在。

[[glob_budget]]
pattern = "docs/reference/*.md"
max_file_kb = 24


# ── 仓库外目录（pre-commit 够不着，需 --include-external）──
# 典型用途：agent 的跨会话记忆目录。它不在 git 里，所以不是强制闸门，
# 但不检查就会无限膨胀 —— 而膨胀的代价是每次会话都付。

# [[external_dir]]
# path = "~/.claude/projects/<your-project-slug>/memory"
# glob = "*.md"
# max_file_kb = 20
#
# 例外**必须带理由** —— 没有「什么时候撤销」的例外会让这张表变成垃圾桶，
# 几轮之后就没人知道每条为什么在这儿。加之前先问：是这个文件真有正当理由，
# 还是我在迁就一个压不下去的数字？后者应该去压内容，不是来加例外。
# 用到例外时 checker 会把它打出来 —— 静默放过等于没有例外表。
#
# [external_dir.exempt]
# "some-oversized-fact.md" = { max_kb = 25, reason = "2026-08-13 已先压内容 1.2 KB，仍超；下次重审时若仍 >24 KB 就拆成两个 fact" }
